# Noitis website publication address. Use a trailing slash.
VITE_SITE_URL=http://localhost:5173/

# Product cards intentionally route to static landing pages owned by this
# website. Operational application URLs remain unpublished until a separate
# pre-production/production environment is explicitly approved.

# Optional owner-only visitor analytics. The Cloudflare Web Analytics site token
# is a public beacon identifier, not a dashboard/read credential. Leave empty
# until the Noitis Web Analytics site exists in the owner's Cloudflare account.
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
